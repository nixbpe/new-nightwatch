# NightWatch environment contract (example). Every value here is empty or a
# non-secret development default — never commit real credentials.
#
# `bun run db:up` generates real development values in .env.compose.local
# (gitignored): database passwords and BETTER_AUTH_SECRET. scripts/dev.mjs
# combines that file with the per-worktree computed ports and forwards the
# variables below to the dev servers. Set variables here (root `.env`, loaded
# automatically by bun) or export them in your shell only to override the
# generated development defaults.
#
# Production: every variable must come from the approved secret store.
# There is no SMTP/auth fallback in production — email verification, password
# reset and invitations require real configured SMTP.

# --- Database (packages/db) ---
# Runtime application/test role: non-owner, NOBYPASSRLS.
DATABASE_URL=
# Owner role: DDL/migrations/provisioning only. The migration runner resolves
# DATABASE_OWNER_URL before DATABASE_URL (owner-before-app rule).
DATABASE_OWNER_URL=

# --- Auth (Better Auth) ---
# Minimum 32 characters; generate one per environment. Dev value is generated
# into .env.compose.local by `bun run db:up`.
BETTER_AUTH_SECRET=

# --- Origins ---
# Browser origin of the SPA. Local dev: scripts/dev.mjs computes
# http://localhost:<WEB_PORT>. Must be the exact public frontend origin.
APP_URL=
# Public origin of the API (Better Auth base URL / trusted origins).
# Local dev: http://localhost:<API_PORT>.
BETTER_AUTH_URL=
# Exact frontend origin allowed by CORS; must equal APP_URL. Never widen to
# multiple origins for convenience.
CORS_ORIGIN=

# --- SMTP ---
# Optional in development (captured by Mailpit via `bun run db:up`, visible at
# the mailpit web UI port); REQUIRED in production. No fallback sender exists.
SMTP_HOST=
SMTP_PORT=
# "true" only for TLS-on-connect (port 465); "false" for STARTTLS/plain.
SMTP_SECURE=
# Paired: SMTP_USER requires SMTP_PASSWORD and vice versa — set both or neither.
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
