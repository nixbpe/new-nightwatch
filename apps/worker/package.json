{
  "name": "@nightwatch/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "WORKER_ROLES=consumer,scheduler,monitor-scheduler,monitor-checker,audit-exporter bun --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --exclude 'src/**/*.db.test.ts'",
    "test:integration": "vitest run src/materialize.db.test.ts src/dispatch.db.test.ts src/monitor/scheduler.db.test.ts src/monitor/checker.db.test.ts src/monitor/checker-process.db.test.ts src/monitor/checker-ssl.db.test.ts src/monitor/notifications.db.test.ts src/audit/exporter.db.test.ts",
    "test:bun": "bun --bun vitest run src/monitor/checker.db.test.ts src/monitor/checker-ssl.db.test.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@nightwatch/db": "workspace:*",
    "@nightwatch/shared": "workspace:*",
    "bullmq": "^5.71.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nightwatch/eslint-config": "workspace:*",
    "@nightwatch/typescript-config": "workspace:*",
    "vitest": "^5.0.0"
  }
}
