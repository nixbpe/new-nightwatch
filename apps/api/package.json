{
  "name": "@nightwatch/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "provision-organization": "bun run src/operator/provision-organization.ts",
    "provision-e2e-fixture": "bun run src/operator/provision-e2e-fixture.ts",
    "emit-openapi": "bun run src/operator/emit-openapi.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "lint": "eslint .",
    "typecheck": "bun check -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:bun": "bun --bun vitest run --project integration src/monitors/test-route.db.test.ts src/monitors/secrets.db.test.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.0.0",
    "@nightwatch/api-contract": "workspace:*",
    "@nightwatch/db": "workspace:*",
    "@nightwatch/shared": "workspace:*",
    "better-auth": "1.6.23",
    "hono": "~4.13.5",
    "ioredis": "5.11.1",
    "nodemailer": "^10.0.1",
    "pg": "^8.23.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nightwatch/eslint-config": "workspace:*",
    "@nightwatch/typescript-config": "workspace:*",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^5.0.0",
    "vitest": "^5.0.0"
  }
}
