{
  "name": "@nightwatch/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/zod-openapi": "0.19.10",
    "@nightwatch/api-contract": "workspace:*",
    "@nightwatch/shared": "workspace:*",
    "hono": "~4.12.0",
    "zod": "~3.25.0"
  },
  "devDependencies": {
    "@nightwatch/eslint-config": "workspace:*",
    "@nightwatch/typescript-config": "workspace:*",
    "@vitest/coverage-v8": "^5.0.0",
    "vitest": "^5.0.0"
  }
}
